# Preview static assets. Keep mutable paths on Cloudflare's default revalidation.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Kxvd/XEm33obXlimfkTmhA9beA2KUfgygBFTw3LbJBw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
