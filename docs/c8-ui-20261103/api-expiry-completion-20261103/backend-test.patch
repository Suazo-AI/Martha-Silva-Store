+    [Fact]
+    public async Task Expired_cookie_is_rejected_by_fake_TimeProvider_before_database_resolution()
+    {
+        var time = new TestTime(Now);
+        var databaseResolutions = 0;
+        await using var app = await TestApp(() =>
+        {
+            Interlocked.Increment(ref databaseResolutions);
+            throw new InvalidOperationException("Test: expired cookies must not resolve database configuration.");
+        }, time);
+        var options = app.Services.GetRequiredService<IOptionsMonitor<CookieAuthenticationOptions>>()
+            .Get(InternalSecurityRules.Scheme);
+        Assert.Same(time, app.Services.GetRequiredService<TimeProvider>());
+        Assert.Same(time, options.TimeProvider);
+        Assert.Equal(typeof(InternalCookieEvents), options.EventsType);
+        Assert.False(options.SlidingExpiration);
+        Assert.Equal(TimeSpan.FromHours(8), options.ExpireTimeSpan);
+
+        var (staff, session) = Fixture();
+        session.CreatedAt = time.GetUtcNow();
+        session.ExpiresAt = session.CreatedAt.AddHours(8);
+        var principal = InternalSecurityRules.Principal(staff, session);
+        var ticket = new AuthenticationTicket(principal, new AuthenticationProperties
+        {
+            IssuedUtc = session.CreatedAt, ExpiresUtc = session.ExpiresAt,
+            IsPersistent = false, AllowRefresh = false
+        }, InternalSecurityRules.Scheme);
+        var protectedTicket = options.TicketDataFormat.Protect(ticket);
+        var roundtrip = options.TicketDataFormat.Unprotect(protectedTicket);
+        Assert.NotNull(roundtrip);
+        Assert.Equal(InternalSecurityRules.Scheme, roundtrip.AuthenticationScheme);
+        Assert.Equal(InternalSecurityRules.Scheme, roundtrip.Principal.Identity!.AuthenticationType);
+        Assert.Equal(session.CreatedAt, roundtrip.Properties.IssuedUtc);
+        Assert.Equal(session.ExpiresAt, roundtrip.Properties.ExpiresUtc);
+        Assert.True(InternalSecurityRules.SessionIsValid(staff, session, roundtrip.Principal, time.GetUtcNow()));
+
+        using var client = app.GetTestClient();
+        client.BaseAddress = new Uri("https://localhost");
+        client.DefaultRequestHeaders.Add("Cookie", $"{options.Cookie.Name}={protectedTicket}");
+        time.Advance(TimeSpan.FromHours(8).Add(TimeSpan.FromSeconds(1)));
+        Assert.True(time.GetUtcNow() > roundtrip.Properties.ExpiresUtc);
+        Assert.Equal(HttpStatusCode.Unauthorized, (await client.GetAsync("/internal/api/security/me")).StatusCode);
+        Assert.Equal(0, databaseResolutions);
+        Assert.Equal(HttpStatusCode.Unauthorized, (await client.GetAsync("/internal/api/security/me")).StatusCode);
+        Assert.Equal(0, databaseResolutions);
+
+        // A nonexpired ticket reaches the unchanged production validation event and trips the DB guard.
+        // Use a separate host so the expired host's database-resolution count remains zero throughout.
+        var controlDatabaseResolutions = 0;
+        await using var control = await TestApp(() =>
+        {
+            Interlocked.Increment(ref controlDatabaseResolutions);
+            throw new InvalidOperationException("Test: nonexpired cookie reached guarded database resolution.");
+        }, new TestTime(Now));
+        var controlOptions = control.Services.GetRequiredService<IOptionsMonitor<CookieAuthenticationOptions>>()
+            .Get(InternalSecurityRules.Scheme);
+        using var controlClient = control.GetTestClient();
+        controlClient.BaseAddress = new Uri("https://localhost");
+        controlClient.DefaultRequestHeaders.Add("Cookie", $"{controlOptions.Cookie.Name}={controlOptions.TicketDataFormat.Protect(ticket)}");
+        var error = await Assert.ThrowsAsync<InvalidOperationException>(() => controlClient.GetAsync("/internal/api/security/me"));
+        Assert.Equal("Test: nonexpired cookie reached guarded database resolution.", error.Message);
+        Assert.Equal(1, controlDatabaseResolutions);
+        Assert.Equal(0, databaseResolutions);
+    }
+
