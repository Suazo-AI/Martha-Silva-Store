+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace Martha.Store.Api.Internal;
+
+public static class InternalCustomerEmail
+{
+    public static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value)
+        ? null : value.Trim().Normalize(NormalizationForm.FormC).ToLowerInvariant();
+}
+
+public sealed class InternalOutboxEvent
+{
+    public Guid EventId { get; set; }
+    public long? PublicationPosition { get; set; }
+    public string Type { get; set; } = "";
+    public int SchemaVersion { get; set; } = 1;
+    public Guid ResourceId { get; set; }
+    public Guid? OriginalBranchId { get; set; }
+    public DateTimeOffset OccurredAt { get; set; }
+    public string PayloadJson { get; set; } = "{}";
+    public string PublisherState { get; set; } = "pending";
+}
+
+public sealed class InternalCustomerConsent
+{
+    public Guid Id { get; set; }
+    public Guid PartyId { get; set; }
+    public string Purpose { get; set; } = "";
+    public string PolicyVersion { get; set; } = "";
+    public DateTimeOffset RecordedAt { get; set; }
+    public string ActorType { get; set; } = "";
+    public string Source { get; set; } = "";
+    public Guid? StaffActorId { get; set; }
+    public DateTimeOffset? WithdrawnAt { get; set; }
+}
+
+// A claimed email is not verified ownership. Public admission must never link an existing Party by email alone.
+public sealed class InternalWebsiteAccount
+{
+    public Guid Id { get; set; }
+    public Guid PartyId { get; set; }
+    private string normalizedEmail = "";
+    public string NormalizedEmail { get => normalizedEmail; set => normalizedEmail = InternalCustomerEmail.Normalize(value) ?? ""; }
+    public DateTimeOffset CreatedAt { get; set; }
+    public DateTimeOffset? VerifiedAt { get; set; }
+    public DateTimeOffset? DisabledAt { get; set; }
+}
+
+public sealed partial class InternalDbContext
+{
+    private static void ConfigureEvents(ModelBuilder model)
+    {
+        model.Entity<InternalOutboxEvent>(e =>
+        {
+            e.ToTable("EventOutbox", t =>
+            {
+                t.HasCheckConstraint("CK_EventOutbox_Version", "[SchemaVersion] > 0");
+                t.HasCheckConstraint("CK_EventOutbox_Payload", "ISJSON([PayloadJson]) = 1");
+                t.HasCheckConstraint("CK_EventOutbox_Publication", "([PublisherState] = 'pending' AND [PublicationPosition] IS NULL) OR ([PublisherState] = 'published' AND [PublicationPosition] > 0)");
+            });
+            e.HasKey(x => x.EventId); e.Property(x => x.EventId).ValueGeneratedNever();
+            e.Property(x => x.PublicationPosition).ValueGeneratedNever();
+            e.HasIndex(x => x.PublicationPosition).IsUnique().HasFilter("[PublicationPosition] IS NOT NULL");
+            e.Property(x => x.Type).HasMaxLength(80).IsUnicode(false).UseCollation("Latin1_General_100_BIN2");
+            e.HasIndex(x => new { x.Type, x.ResourceId }).IsUnique(); // One event per semantic change/type.
+            e.Property(x => x.PublisherState).HasMaxLength(16).IsUnicode(false).UseCollation("Latin1_General_100_BIN2");
+            e.Property(x => x.PayloadJson).HasMaxLength(2048).IsRequired();
+        });
+        model.Entity<InternalCustomerConsent>(e =>
+        {
+            e.ToTable("CustomerConsents", t =>
+            {
+                t.HasCheckConstraint("CK_CustomerConsents_Actor", "([ActorType] = 'staff' AND [StaffActorId] IS NOT NULL) OR ([ActorType] IN ('anonymous', 'customer') AND [StaffActorId] IS NULL)");
+                t.HasCheckConstraint("CK_CustomerConsents_Purpose", "LEN(LTRIM(RTRIM([Purpose]))) > 0 AND LEN(LTRIM(RTRIM([PolicyVersion]))) > 0 AND LEN(LTRIM(RTRIM([Source]))) > 0");
+                t.HasCheckConstraint("CK_CustomerConsents_Withdrawal", "[WithdrawnAt] IS NULL OR [WithdrawnAt] >= [RecordedAt]");
+            });
+            e.HasKey(x => x.Id); e.Property(x => x.Id).ValueGeneratedNever();
+            e.Property(x => x.Purpose).HasMaxLength(80); e.Property(x => x.PolicyVersion).HasMaxLength(80);
+            e.Property(x => x.ActorType).HasMaxLength(16).IsUnicode(false).UseCollation("Latin1_General_100_BIN2");
+            e.Property(x => x.Source).HasMaxLength(80);
+            e.HasIndex(x => new { x.PartyId, x.Purpose });
+            e.HasOne<InternalParty>().WithMany().HasForeignKey(x => x.PartyId).OnDelete(DeleteBehavior.Restrict);
+            e.HasOne<InternalStaff>().WithMany().HasForeignKey(x => x.StaffActorId).OnDelete(DeleteBehavior.Restrict);
+        });
+        model.Entity<InternalWebsiteAccount>(e =>
+        {
+            e.ToTable("WebsiteAccounts", t => t.HasCheckConstraint("CK_WebsiteAccounts_Email", "LEN(LTRIM(RTRIM([NormalizedEmail]))) > 0"));
+            e.HasKey(x => x.Id); e.Property(x => x.Id).ValueGeneratedNever();
+            e.Property(x => x.NormalizedEmail).HasMaxLength(254).UseCollation("Latin1_General_100_BIN2");
+            e.HasIndex(x => x.NormalizedEmail).IsUnique();
+            e.HasOne<InternalParty>().WithMany().HasForeignKey(x => x.PartyId).OnDelete(DeleteBehavior.Restrict);
+        });
+    }
+}
