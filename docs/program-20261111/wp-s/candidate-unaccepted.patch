diff --git a/backend/tests/Martha.Store.Api.Tests/InternalEventContractTests.cs b/backend/tests/Martha.Store.Api.Tests/InternalEventContractTests.cs
new file mode 100644
index 0000000..d2147b2
--- /dev/null
+++ b/backend/tests/Martha.Store.Api.Tests/InternalEventContractTests.cs
@@ -0,0 +1,138 @@
+using System.Text.Json;
+using Martha.Store.Api.Internal;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Identity;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Metadata;
+using Microsoft.EntityFrameworkCore.Migrations;
+using Microsoft.EntityFrameworkCore.Migrations.Operations;
+using Xunit;
+
+namespace Martha.Store.Api.Tests;
+
+public sealed class InternalEventContractTests
+{
+    [Theory]
+    [InlineData("  CLIENT@EXAMPLE.COM  ", "client@example.com")]
+    [InlineData(" E\u0301@EXAMPLE.COM ", "é@example.com")]
+    [InlineData(" ", null)]
+    [InlineData(null, null)]
+    public void Normalization_preserves_identity_policy(string? raw, string? expected)
+    {
+        var party = new InternalParty { Email = raw };
+        Assert.Equal(expected, party.NormalizedEmail);
+        Assert.Equal(expected, InternalCustomerEmail.Normalize(raw));
+        Assert.Equal(expected ?? "", new InternalWebsiteAccount { NormalizedEmail = raw! }.NormalizedEmail);
+        party.Email = null;
+        Assert.Null(party.NormalizedEmail);
+    }
+
+    [Fact]
+    public void Contract_migration_is_additive_and_contains_no_legacy_data_rewrite()
+    {
+        using var db = new InternalDbContextFactory().CreateDbContext([]);
+        var assembly = db.GetService<IMigrationsAssembly>();
+        var migration = assembly.CreateMigration(assembly.Migrations["20261112004549_CustomerEventContracts"], db.Database.ProviderName!);
+        Assert.All(migration.UpOperations, op => Assert.True(op is AddColumnOperation or CreateTableOperation or CreateIndexOperation));
+        Assert.Single(migration.UpOperations.OfType<AddColumnOperation>());
+        Assert.Equal(3, migration.UpOperations.OfType<CreateTableOperation>().Count());
+        Assert.DoesNotContain(migration.UpOperations, op => op is SqlOperation or InsertDataOperation or UpdateDataOperation or DeleteDataOperation);
+    }
+
+    [Fact]
+    public void Consent_and_account_metadata_do_not_opt_in_or_merge_legacy_parties()
+    {
+        using var db = new InternalDbContextFactory().CreateDbContext([]);
+        var model = db.GetService<IDesignTimeModel>().Model;
+        var consent = model.FindEntityType(typeof(InternalCustomerConsent))!;
+        Assert.Empty(consent.GetSeedData());
+        Assert.True(consent.FindProperty("StaffActorId")!.IsNullable);
+        Assert.True(consent.FindProperty("WithdrawnAt")!.IsNullable);
+        foreach (var name in new[] { "Purpose", "PolicyVersion", "RecordedAt", "ActorType", "Source" })
+            Assert.False(consent.FindProperty(name)!.IsNullable);
+        Assert.DoesNotContain(model.FindEntityType(typeof(InternalParty))!.GetIndexes(), x => x.IsUnique);
+        Assert.Contains(model.FindEntityType(typeof(InternalWebsiteAccount))!.GetIndexes(),
+            x => x.IsUnique && x.Properties.Single().Name == "NormalizedEmail");
+    }
+
+    [Fact]
+    public void Rejection_cleanup_removes_unsaved_event_from_actual_tracker()
+    {
+        using var db = new InternalDbContextFactory().CreateDbContext([]);
+        db.Add(Event(Guid.NewGuid()));
+        Assert.Single(db.ChangeTracker.Entries<InternalOutboxEvent>());
+        db.ChangeTracker.Clear(); // The actual runner's rejection cleanup; persisted rollback is SQL-gated below.
+        Assert.Empty(db.ChangeTracker.Entries<InternalOutboxEvent>());
+    }
+
+    [Fact]
+    public async Task Writer_rejects_calls_outside_business_transaction()
+    {
+        using var db = new InternalDbContextFactory().CreateDbContext([]);
+        await Assert.ThrowsAsync<InvalidOperationException>(() => InternalOutboxWriter.PaidSale(db,
+            Guid.NewGuid(), Guid.NewGuid(), DateTimeOffset.UtcNow, default));
+    }
+
+    [Fact]
+    public void Legacy_replay_retains_contact_after_party_only_anonymization_documented_limit()
+    {
+        var party = new InternalParty { Id = Guid.NewGuid(), Name = "Synthetic Customer", Email = "synthetic@example.invalid", Phone = "5550100" };
+        var json = JsonSerializer.Serialize(InternalResult<InternalPartyView>.Ok(new(party.Id, "customer", party.Name, party.Email, party.Phone, true)));
+        party.Name = "Anonymized"; party.Email = null; party.Phone = null; party.Active = false;
+        var replay = JsonSerializer.Deserialize<InternalResult<InternalPartyView>>(json)!;
+        Assert.Equal("synthetic@example.invalid", replay.Value!.Email);
+        Assert.Equal("5550100", replay.Value.Phone);
+        // Explicit retained-copy test, NOT a claim that Party-only erasure is safe. See CONTRACTS erasure gate.
+    }
+
+    [Fact]
+    public void New_script_objects_are_guarded_and_positions_are_not_precommit_identity()
+    {
+        var sql = InternalReleaseScriptTests.CheckedInScript();
+        foreach (var table in new[] { "EventOutbox", "CustomerConsents", "WebsiteAccounts" })
+            Assert.Contains($"CREATE TABLE [savia_internal].[{table}]", sql);
+        Assert.Contains("[PublicationPosition] bigint NULL", sql);
+        Assert.Contains("[NormalizedEmail] nvarchar(254) COLLATE Latin1_General_100_BIN2 NULL", sql);
+        Assert.Contains("WHERE [PublicationPosition] IS NOT NULL", sql);
+        using var db = new InternalDbContextFactory().CreateDbContext([]);
+        Assert.Equal(ValueGenerated.Never, db.Model.FindEntityType(typeof(InternalOutboxEvent))!.FindProperty("PublicationPosition")!.ValueGenerated);
+    }
+
+    [InternalCommerceSqlFact]
+    public async Task Runner_savepoint_rejection_removes_persisted_event_but_keeps_rejection_receipt()
+    {
+        await using var fixture = await InternalCommerceSqlDatabase.Create();
+        await using var db = fixture.Context();
+        var principal = InternalSecurityRules.Principal(fixture.Staff, fixture.Session);
+        var runner = new InternalCommandRunner(db, new(db, new PasswordHasher<InternalStaff>(), TimeProvider.System),
+            new HttpContextAccessor { HttpContext = new DefaultHttpContext { User = principal } }, TimeProvider.System);
+        var outcome = await runner.Run<string>(fixture.Actor, "directory.items.create", "outbox-rollback-0001",
+            InternalRules.Fingerprint(new { Test = "rollback" }), async ct => {
+                db.Add(Event(Guid.NewGuid())); await db.SaveChangesAsync(ct);
+                return InternalResult<string>.Fail("invalid_request");
+            }, default);
+        Assert.Equal("invalid_request", outcome.Error);
+        await using var verify = fixture.Context();
+        Assert.False(await verify.Set<InternalOutboxEvent>().AnyAsync());
+        Assert.Single(await verify.Set<InternalOperation>().ToListAsync());
+    }
+
+    [InternalCommerceSqlFact]
+    public async Task Publisher_late_source_gets_later_position_and_retry_preserves_positions()
+    {
+        await using var fixture = await InternalCommerceSqlDatabase.Create();
+        var early = Event(Guid.NewGuid()); var late = Event(Guid.NewGuid());
+        late.OccurredAt = early.OccurredAt.AddMinutes(-1); // Timestamp order differs from visibility order.
+        await using (var db = fixture.Context()) { db.Add(early); await db.SaveChangesAsync(); }
+        await using (var publisher = fixture.Context()) Assert.Equal(1, await InternalOutboxWriter.AssignPublicationPositions(publisher, default));
+        await using (var db = fixture.Context()) { db.Add(late); await db.SaveChangesAsync(); }
+        await using (var publisher = fixture.Context()) Assert.Equal(1, await InternalOutboxWriter.AssignPublicationPositions(publisher, default));
+        await using (var publisher = fixture.Context()) Assert.Equal(0, await InternalOutboxWriter.AssignPublicationPositions(publisher, default));
+        await using var verify = fixture.Context();
+        Assert.Equal(new long?[] { 1, 2 }, await verify.Set<InternalOutboxEvent>().OrderBy(x => x.PublicationPosition).Select(x => x.PublicationPosition).ToArrayAsync());
+        Assert.Equal(late.EventId, (await verify.Set<InternalOutboxEvent>().SingleAsync(x => x.PublicationPosition == 2)).EventId);
+    }
+
+    private static InternalOutboxEvent Event(Guid id) => new() { EventId = id, ResourceId = id, Type = "sale.paid", OccurredAt = DateTimeOffset.UtcNow };
+}
