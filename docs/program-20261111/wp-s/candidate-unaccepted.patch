@@ -0,0 +1,34 @@
+using System.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace Martha.Store.Api.Internal;
+
+public static class InternalOutboxWriter
+{
+    // Invoke ONLY inside the runner action, after a new paid sale has been persisted.
+    // RollbackToSavepoint + ChangeTracker.Clear remove saved AND unsaved events.
+    public static async Task PaidSale(InternalDbContext db, Guid saleId, Guid locationId,
+        DateTimeOffset occurredAt, CancellationToken ct)
+    {
+        if (db.Database.CurrentTransaction is null) throw new InvalidOperationException("Outbox requires the business transaction.");
+        var branch = await db.InternalLocations.Where(x => x.Id == locationId).Select(x => x.BranchId).SingleAsync(ct);
+        db.Add(new InternalOutboxEvent { EventId = saleId, Type = "sale.paid", ResourceId = saleId,
+            OriginalBranchId = branch, OccurredAt = occurredAt }); // Empty frozen payload: invalidation only.
+    }
+
+    // Publisher primitive; WP-B supplies scheduling, transport and retention. No network inside this transaction.
+    // Every publisher uses the same transaction-owned SQL application lock, across processes.
+    // MAX is safe only under this lock and while the highest position is retained (see CONTRACTS).
+    public static async Task<int> AssignPublicationPositions(InternalDbContext db, CancellationToken ct)
+    {
+        if (db.Database.CurrentTransaction is not null) throw new InvalidOperationException("Publisher must run after source commit in a separate context.");
+        await using var tx = await db.Database.BeginTransactionAsync(IsolationLevel.ReadCommitted, ct);
+        await db.Database.ExecuteSqlRawAsync("DECLARE @r int; EXEC @r=sys.sp_getapplock @Resource='SaviaInternal:outbox-publisher:v1',@LockMode='Exclusive',@LockOwner='Transaction',@LockTimeout=10000; IF @r<0 THROW 51000,'Publisher lock unavailable',1;", ct);
+        var position = await db.Set<InternalOutboxEvent>().MaxAsync(x => x.PublicationPosition, ct) ?? 0;
+        var pending = await db.Set<InternalOutboxEvent>().Where(x => x.PublicationPosition == null)
+            .OrderBy(x => x.OccurredAt).ThenBy(x => x.EventId).Take(100).ToListAsync(ct);
+        foreach (var row in pending) { row.PublicationPosition = checked(++position); row.PublisherState = "published"; }
+        await db.SaveChangesAsync(ct); await tx.CommitAsync(ct);
+        return pending.Count;
+    }
+}
