    "/api/v2/synthetic/reservations": {
      "post": {
        "summary": "Create reservation or replay the original immutable receipt (201).",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[!-~]{8,128}$"
            },
            "description": "Exactly one value. Case-sensitive visible ASCII without spaces. Retain for the life of this disposable synthetic database."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Create reservation or replay the original immutable receipt (201).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationReceipt"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Current reservation resource; its GET state may change without changing this receipt.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request; strict unknown-field rejection, nonempty UUIDs and quantity 1..100.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "attempt_unknown: no durable receipt found; outcome remains unknown, do not fail over.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "authority_mismatch, idempotency_conflict, attempt_conflict or out_of_stock.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "storage_unavailable. Outcome may be unknown; retain authority, attemptId and key; do not send to another ERP.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "internal_error. Outcome may be unknown; reconcile on the same authority.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
