{
  "openapi": "3.0.3",
  "info": {
    "title": "Martha SAVIA Synthetic ERP V2",
    "version": "2.0.0",
    "description": "Development AND Synthetic:Enabled=true only; all V2 routes absent otherwise. Isolated V2 tables, no conversion from V1. Prices from server, XXX fixtures, one variant/location. No production auth, payments, sale, shipment, return or expiration. No CGA endpoint or failover. SQL runtime unverified until separately authorized real-SQL tests run. V1 contract unchanged."
  },
  "paths": {
    "/api/v2/synthetic/catalog": {
      "get": {
        "summary": "Synthetic V2 inventory; available = onHand - reserved. No V1 conversion.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Synthetic V2 inventory; available = onHand - reserved. No V1 conversion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request; strict unknown-field rejection, nonempty UUIDs and quantity 1..100.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "attempt_unknown: no durable receipt found; outcome remains unknown, do not fail over.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "storage_unavailable. Outcome may be unknown; retain authority, attemptId and key; do not send to another ERP.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "internal_error. Outcome may be unknown; reconcile on the same authority.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
