<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Explicit security floor: SqlClient transitive PKCS 9.0.11 is vulnerable (CVE-2026-84008 / CVE-2026-70162). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../dev/savia-staff-ui/index.html" LogicalName="SaviaStaff.index.html" />
    <EmbeddedResource Include="../../../dev/savia-staff-ui/login.html" LogicalName="SaviaStaff.login.html" />
    <EmbeddedResource Include="../../../dev/savia-staff-ui/styles.css" LogicalName="SaviaStaff.styles.css" />
    <EmbeddedResource Include="../../../dev/savia-staff-ui/app.mjs" LogicalName="SaviaStaff.app.mjs" />
    <EmbeddedResource Include="../../../dev/savia-staff-ui/client.mjs" LogicalName="SaviaStaff.client.mjs" />
    <EmbeddedResource Include="../../../dev/savia-staff-ui/login.mjs" LogicalName="SaviaStaff.login.mjs" />
  </ItemGroup>
</Project>
