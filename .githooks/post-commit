#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
if command -v python >/dev/null 2>&1; then
    exec python "$root/tools/progress.py" publish
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/tools/progress.py" publish
else
    echo 'Progress sync BLOCKED: Python is required. Commit remains local.' >&2
    exit 1
fi
