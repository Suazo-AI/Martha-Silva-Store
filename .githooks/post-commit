#!/bin/sh
# Opt-in through repository-local core.hooksPath; Python 3 must be on PATH.
root=$(git rev-parse --show-toplevel) || exit 1
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/tools/sync_progress.py"
elif command -v python >/dev/null 2>&1; then
    exec python "$root/tools/sync_progress.py"
else
    echo 'Auto-sync blocked: Python 3 is required. Commit remains local.' >&2
    exit 1
fi
